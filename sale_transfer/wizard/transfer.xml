<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_batch_transfer_wizard_form" model="ir.ui.view">
        <field name="name">sale.batch.transfer.wiz.form</field>
        <field name="model">sale.batch.transfer.wiz</field>
        <field name="arch" type="xml">
            <form string="Sale Batch Transfer">
                <group>
                    <field name="printer_id" widget="selection"/>
                    <field name="invoice" widget="boolean_toggle"/>
                    <field name="email" widget="boolean_toggle"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_batch_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Action Sale Batch Transfer</field>
        <field name="res_model">sale.batch.transfer.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_sale_batch_transfer_wizard_form"/>
    </record>
</odoo>