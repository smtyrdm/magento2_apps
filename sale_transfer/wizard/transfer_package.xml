<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_sale_transfer_package_form" model="ir.ui.view">
        <field name="name">sale.transfer.package.form</field>
        <field name="model">sale.transfer.package</field>
        <field name="arch" type="xml">
            <form string="Sale Transfer Package">
                <group>
                    <field name="sale_id" readonly="1"/>
                </group>
                <group>
                    <field name="package_line" nolabel="1">
                        <tree editable="bottom"  delete="1">
                            <field name="product_id" required="1"/>
                            <field name="qty" required="1"/>
                            <field name="move_id" invisible="1"/>
                            <field name="picking_id" readonly="1"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button string="Add Pallet" type="object" name="action_add_pallet" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
