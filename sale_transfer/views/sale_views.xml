<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_transfer" model="ir.ui.view">
        <field name="name">sale.transfer</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree string="Sale Transfer" create="0" import="0" multi_edit="1" editable="top">
                <field name="id" readonly="1"/>
                <field name="order_id" readonly="1"/>
                <field name="name" readonly="1" />
                <field name="product_uom_qty" readonly="1"/>
                <field name="qty_delivered" readonly="1"/>
                <field name="qty_done" readonly="0" widget="sale_qty_done"/>
                <field name="transfer_time" widget="remaining_days"/>
                <field name="transfer_state" widget="badge" decoration-success="transfer_state == 'assigned'" decoration-info="transfer_state == 'done'"/>

                <groupby name="order_id">
                    <button name="action_open_add_pallet_wizard"
                            type="object"
                            string="Add Pallet">Pallet
                    </button>
                    <button name="action_open_delivery_form"
                            icon="fa-truck"
                            type="object"
                            string="Open Delivery"/>
                </groupby>
            </tree>
        </field>
    </record>

    <record id="view_sale_transfer_search" model="ir.ui.view">
        <field name="name">sale.transfer.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Sale Transfer Search">
                <field name="id"/>
                <field name="product_id"/>
                <field name="order_id"/>
                <filter string="Available" name="available" domain="[('transfer_state','=','assigned')]"/>
                <filter string="Not Delivered" name="not_delivered" domain="[('transfer_state','not in',['done','cancel'])]"/>
                <filter string="Delivered" name="delivered" domain="[('transfer_state','=','done')]"/>
                <filter string="Transfer Time" name="transfer_time_filter" domain="[('transfer_time', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Product Category" name="group_by_category" context="{'group_by': 'product_categ_id'}"/>
                    <filter string="Transfer Time" name="group_by_transfer_time" context="{'group_by': 'transfer_time'}"/>
                    <filter string="Transfer State" name="group_by_transfer_state" context="{'group_by': 'transfer_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_transfer" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('state', 'in', ['sale','done']), '|', ('move_ids', '!=', False), ('purchase_line_ids', '!=', False)]</field>
        <!--        <field name="context">{'group_by':'order_id','show_pallet_info': True, 'search_default_not_delivered': 1}</field>-->
        <field name="context">{'show_pallet_info': True,'search_default_not_delivered': 1}</field>
        <field name="view_id" ref="view_sale_transfer"/>
        <field name="search_view_id" ref="view_sale_transfer_search"/>
    </record>

    <menuitem id="menu_sale_batch_transfer_root"
              name="Transfer"
              parent="sale.sale_menu_root"
              action="action_sale_transfer"/>
</odoo>